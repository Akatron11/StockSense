@startuml StockSense_ClassDiagram
skinparam classAttributeIconSize 0

class Company {
  id : PK
  name
  is_active
  created_at
  updated_at
}

class Region {
  id : PK
  name
  company_id : FK
  is_active
  created_at
  updated_at
}

class Branch {
  id : PK
  name
  region_id : FK
  is_active
  created_at
  updated_at
}

class Product {
  id : PK
  name
  sku
  category
  default_price
  cost_price
  best_before_date
  is_active
  created_at
  updated_at
}

class Stock {
  product_id : FK, PK
  branch_id : FK, PK
  quantity
  low_stock_threshold
  price_override : nullable
  zone_id : FK, nullable
  created_at
  updated_at
}

class Employee {
  id : PK
  first_name
  last_name
  username : nullable
  password_hash : nullable
  role
  branch_id : FK, nullable
  region_id : FK, nullable
  company_id : FK, nullable
  age
  address
  manager_pin : nullable
  is_active
  created_at
  updated_at
}

class Sale {
  id : PK
  sale_date
  branch_id : FK
  employee_id : FK
  payment_method
  created_at
}

class SaleItem {
  id : PK
  sale_id : FK
  product_id : FK
  quantity
  line_total
  created_at
}

class Return {
  id : PK
  sale_id : FK
  initiated_by : FK
  status
  net_amount
  completed_by : FK, nullable
  completed_at : nullable
  created_at
  updated_at
}

class ReturnItem {
  id : PK
  return_id : FK
  product_id : FK
  quantity
  unit_price
  direction
  created_at
  updated_at
}

class StockRequest {
  id : PK
  product_id : FK
  branch_id : FK
  quantity
  requested_by : FK
  created_at
}

class Shift {
  id : PK
  employee_id : FK
  shift_date
  start_time
  end_time
  is_day_off
  created_at
}

class CompanyFeature {
  company_id : FK
  feature_name
  enabled
  created_at
  updated_at
}

class CompanyBranding {
  company_id : FK, PK
  logo_url
  primary_color
  display_name
  created_at
  updated_at
}

class NotificationRead {
  id : PK
  employee_id : FK
  kind
  product_id : FK
  branch_id : FK
  read_at
  created_at
}

class LayoutZone {
  id : PK
  branch_id : FK
  name
  x
  y
  width
  height
  created_at
  updated_at
}

class StockZone {
  id : PK
  branch_id : FK
  name
  x
  y
  width
  height
  created_at
  updated_at
}

class LayoutRecommendationApplication {
  id : PK
  branch_id : FK
  product_a_id : FK
  product_b_id : FK
  applied_by : FK
  applied_at
  created_at
}

Company "1" -- "*" Region
Region "1" -- "*" Branch
Branch "1" -- "*" Stock
Product "1" -- "*" Stock
Branch "0..1" -- "*" Employee
Region "0..1" -- "*" Employee
Company "0..1" -- "*" Employee
Employee "1" -- "*" Sale
Branch "1" -- "*" Sale
Sale "1" -- "*" SaleItem
Product "1" -- "*" SaleItem
Sale "1" -- "*" Return
Employee "1" -- "*" Return
Return "1" -- "*" ReturnItem
Product "1" -- "*" ReturnItem
Branch "1" -- "*" StockRequest
Product "1" -- "*" StockRequest
Employee "1" -- "*" StockRequest
Employee "1" -- "*" Shift
Company "1" -- "*" CompanyFeature
Company "1" -- "1" CompanyBranding
Employee "1" -- "*" NotificationRead
Product "1" -- "*" NotificationRead
Branch "1" -- "*" NotificationRead
Branch "1" -- "*" LayoutZone
LayoutZone "0..1" -- "*" Stock
Branch "1" -- "*" StockZone
Branch "1" -- "*" LayoutRecommendationApplication
Product "1" -- "*" LayoutRecommendationApplication

@enduml
