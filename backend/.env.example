# Copy to `.env` (same directory) and fill in real values for anything beyond local dev.
# `.env` is gitignored — never commit real secrets.

# Secret used to sign/verify JWTs. Falls back to a hardcoded dev value if unset — always set
# a long random string here before running anywhere beyond your own machine.
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Optional: overrides the default local docker-compose Postgres connection.
# DATABASE_URL=postgresql+psycopg2://stocksense:stocksense@localhost:5432/stocksense
